# GEMINI_API_KEY: Required for Google Gen AI API calls (including Gemma open models).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GEMMA_MODEL: Model identifier for the Gemma open model engine.
# Default verified Gemma model: "gemma-4-26b-a4b-it"
# Other options: "gemma-4-31b-it", or custom self-hosted endpoint models.
GEMMA_MODEL="gemma-4-26b-a4b-it"

# GEMMA_API_ENDPOINT: Optional custom self-hosted Gemma inference endpoint
# e.g., "http://localhost:11434/v1" (Ollama), vLLM, or Hugging Face Inference Endpoints.
# If unset, uses the verified Gemma engine via Google Gen AI API.
# GEMMA_API_ENDPOINT=""

# MONGODB_URI: Optional connection string for MongoDB Atlas persistent challenge storage.
# If omitted, SeeMore AI runs in high-performance in-memory session mode without breaking.
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/seemore_ai?retryWrites=true&w=majority"

